@model MovieApplication

<h2>Confirm Deletion</h2>
<h3>@Model.Title</h3>

<!-- Delete form that confirms with the user that they want to delete a certain movie -->
<form asp-controller="Home" asp-action="Delete" method="post">
    
    <input type="hidden" asp-for="MovieId"/>
    
    <button type="submit">Delete</button>
    <a class="btn btn-info" asp-controller="Home" asp-action="MovieList">Cancel</a>
</form>