@{
    ViewData["Title"] = "Movie Form";
}

@model MovieApplication

<!-- Form to enter movies into the collection -->

<h2>Movie Form</h2>

<form method="post">

    <input type="hidden" asp-for="MovieId"/>

    <!--Category of movie dropdown-->
    <label asp-for="CategoryId">Category:</label>
    <select asp-for="CategoryId">
        <option value="">Select a Category</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option>
        }
    </select>
    <br/><br/>

    <!-- Title of the movie label and input (required)-->
    <label asp-for="Title">Title:</label>
    <input asp-for="Title"/>
    <br/><br/>

    <!-- Year of the movie label and input (required) -->
    <label asp-for="Year">Year:</label>
    <input asp-for="Year"/>
    <br/><br/>

    <!-- Director of the movie label and input-->
    <label asp-for="Director">Director:</label>
    <input asp-for="Director" />
    <br/><br/>

    <!-- Rating of the movie label and dropdown-->
    <label asp-for="Rating">Rating:</label>
    <select asp-for="Rating">
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <br/><br/>

    <!-- Edited movie field with yes/no (true/false) dropdown option (Required) -->
    <label asp-for="Edited">Edited:</label>
    <select asp-for="Edited">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br/><br/>

    <!-- Who the movie was lent to label and input -->
    <label asp-for="LentTo">Lent To:</label>
    <input asp-for="LentTo"/>
    <br/><br/>

    <!-- Copied to Plex field with yes/no (true/false) dropdown option (required) -->
    <label asp-for="CopiedToPlex">Copied To Plex:</label>
    <select asp-for="CopiedToPlex">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <br/><br/>

    <!-- Movie notes label and text area input, has a minimum of 25 characters -->
    <label asp-for="Notes">Notes:</label>
    <textarea asp-for="Notes" maxlength="25"></textarea>
    <br/><br/>

    <button type="submit">Submit Movie</button>
    
    <!-- Makes it so the user is notified if their input doesn't meet the requirements -->
    <div asp-validation-summary="All"></div>

</form>







